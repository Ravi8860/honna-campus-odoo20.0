<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Header Navigation -->
    <template id="honna_header" name="Honna Header">
        <header id="top" class="honna-navbar navbar navbar-expand-lg sticky-top">
            <div class="container-fluid px-lg-4">
                <!-- Brand Logo matching Figma -->
                <a class="navbar-brand me-4 d-flex align-items-center" href="/">
                    <img src="/honna_campus_website/static/src/img/logo_honna_campus.svg" alt="Honna Campus" class="img-fluid" style="height: 38px; width: auto;"/>
                </a>

                <!-- Mobile Hamburger Toggle -->
                <button class="navbar-toggler border-secondary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#honnaNavbarNav" aria-controls="honnaNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links matching Figma (Home, About us, Shop, Courses, Jobs, Contact Us) - Centered -->
                <div class="collapse navbar-collapse" id="honnaNavbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a t-attf-class="nav-link honna-nav-link #{'active' if page_name == 'home' else ''}" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a t-attf-class="nav-link honna-nav-link #{'active' if page_name == 'about' else ''}" href="/about-us">About us</a>
                        </li>
                        <li class="nav-item">
                            <a t-attf-class="nav-link honna-nav-link #{'active' if page_name == 'shop' else ''}" href="/shop">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a t-attf-class="nav-link honna-nav-link #{'active' if page_name in ('courses', 'curriculum') else ''}" href="/courses">Courses</a>
                        </li>
                        <li class="nav-item">
                            <a t-attf-class="nav-link honna-nav-link #{'active' if page_name in ('jobs', 'careers') else ''}" href="/jobs">Jobs</a>
                        </li>
                        <li class="nav-item">
                            <a t-attf-class="nav-link honna-nav-link #{'active' if page_name == 'contact' else ''}" href="/contactus">Contact Us</a>
                        </li>
                    </ul>

                    <!-- Right Action CTA Buttons matching Figma -->
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <t t-if="request.session.uid and not request.env.user._is_public()">
                            <!-- Authenticated User Dropdown Menu with Logout -->
                            <div class="dropdown honna-user-dropdown">
                                <a href="#" class="dropdown-toggle d-flex align-items-center gap-2 text-white text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="honna-avatar-circle bg-primary text-white d-inline-flex align-items-center justify-content-center rounded-circle fw-bold" style="width: 34px; height: 34px; font-size: 0.85rem;">
                                        <t t-out="request.env.user.name[:1].upper() if request.env.user.name else 'U'"/>
                                    </span>
                                    <span class="d-none d-md-inline small fw-semibold text-white">
                                        <t t-out="request.env.user.name"/>
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 py-2 mt-2" style="min-width: 210px;">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="small fw-bold text-dark"><t t-out="request.env.user.name"/></div>
                                        <div class="text-muted small text-truncate" style="font-size: 0.75rem;"><t t-out="request.env.user.email or request.env.user.login"/></div>
                                    </li>
                                    <li t-if="request.env.user.has_group('base.group_user')">
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-primary fw-semibold" href="/odoo">
                                            <i class="oi oi-view-apps"></i> Apps / Backend
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/stakeholder-portals">
                                            <i class="oi oi-user"></i> Stakeholder Portals
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/my">
                                            <i class="oi oi-settings"></i> My Account
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"/></li>
                                    <li>
                                        <form method="POST" action="/web/session/logout?redirect=/" class="p-0 m-0">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger fw-semibold bg-transparent border-0 w-100 text-start">
                                                <i class="oi oi-sign-out"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </t>
                        <t t-else="">
                            <t t-if="page_name == 'register'">
                                <a href="/web/login" class="btn btn-honna-portal-login">Login to Portal</a>
                            </t>
                            <t t-elif="page_name == 'login'">
                                <a href="/registration" class="btn btn-honna-register-outline">Register</a>
                            </t>
                            <t t-else="">
                                <a href="/web/login" class="honna-nav-login">Login</a>
                                <a href="/registration" class="btn btn-honna-register-outline">Register</a>
                            </t>
                        </t>
                    </div>
                </div>
            </div>
        </header>
    </template>

    <!-- Mascot Login Modal -->
    <template id="honna_login_modal" name="Honna Login Modal">
        <t t-if="not request.session.uid or request.env.user._is_public()">
            <div id="honna_login_modal" class="honna-modal-backdrop">
                <div class="honna-modal-card">
                    <button type="button" class="modal-close-btn" id="honna_modal_close" aria-label="Close">&amp;times;</button>
                    
                    <!-- Mascot illustration at bottom right -->
                    <img src="/honna_campus_website/static/src/img/robot_mascot.png" alt="Honna Robot Mascot" class="modal-mascot-img"/>

                    <div class="text-center mb-4">
                        <img src="/honna_campus_website/static/src/img/logo_honna_education.svg" alt="Honna" style="height: 48px; width: auto;"/>
                    </div>

                    <form action="/web/login" method="post" class="honna-modal-login-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="redirect" value="/"/>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="oi oi-user text-muted"></i></span>
                                <input type="text" name="login" class="form-control form-control-honna border-start-0" placeholder="Enter your email" required="required"/>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="oi oi-lock text-muted"></i></span>
                                <input type="password" name="password" class="form-control form-control-honna border-start-0" placeholder="Password" required="required"/>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 small">
                            <a href="/web/reset_password" class="text-decoration-none text-muted">Forgot Password?</a>
                            <a href="/registration" class="text-decoration-none text-primary fw-semibold">New user? Register</a>
                        </div>

                        <div class="text-center oe_login_buttons">
                            <button type="submit" class="btn btn-honna-contact w-100 py-2 fs-6">Login</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- Custom Footer matching Figma -->
    <template id="honna_footer" name="Honna Footer">
        <footer class="honna-footer">
            <div class="container py-2">
                <div class="row g-4 justify-content-between">
                    <!-- Col 1: Logo & Mission -->
                    <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                        <img src="/honna_campus_website/static/src/img/logo_honna_campus.svg" alt="Honna Campus" style="height: 42px; width: auto;" class="mb-3 d-block"/>
                        <p class="honna-footer-mission text-white-50 pe-xl-4 mb-0" style="font-size: 0.95rem; line-height: 1.65; max-width: 380px;">
                            To build a unified, technology-driven platform that connects schools, universities, educators, service partners, and learners into one cohesive ecosystem
                        </p>
                    </div>

                    <!-- Col 2: Honna Links -->
                    <div class="col-lg-2 col-md-6 col-6 mb-4 mb-lg-0">
                        <h5 class="footer-heading text-white fw-bold mb-3" style="font-size: 1.15rem;">Honna</h5>
                        <ul class="footer-links list-unstyled p-0 m-0">
                            <li class="mb-2"><a href="/about-us" class="text-white-50 text-decoration-none">About Us</a></li>
                            <li class="mb-2"><a href="/shop" class="text-white-50 text-decoration-none">Shop</a></li>
                            <li class="mb-2"><a href="/courses" class="text-white-50 text-decoration-none">Courses</a></li>
                            <li class="mb-2"><a href="/jobs" class="text-white-50 text-decoration-none">Jobs</a></li>
                            <li class="mb-2"><a href="/contactus" class="text-white-50 text-decoration-none">Contact Us</a></li>
                        </ul>
                    </div>

                    <!-- Col 3: Contact Details -->
                    <div class="col-lg-3 col-md-6 col-6 mb-4 mb-lg-0">
                        <h5 class="footer-heading text-white fw-bold mb-3" style="font-size: 1.15rem;">Contact</h5>
                        <div class="honna-footer-contact" style="font-size: 0.95rem; line-height: 1.6;">
                            <div class="text-white fw-bold">Honna Education</div>
                            <div class="text-white-50 mb-3">Bengaluru 560035, Karnataka, India</div>
                            
                            <div class="text-white fw-bold">Email:</div>
                            <div class="mb-3"><a href="mailto:stemlab@honna.in" class="text-white-50 text-decoration-none">stemlab@honna.in</a></div>
                            
                            <div class="text-white fw-bold">Phone:</div>
                            <div><a href="tel:+918904277404" class="text-white-50 text-decoration-none">+91 89042 77404</a></div>
                        </div>
                    </div>

                    <!-- Col 4: Follow Us (2x2 Social Grid) -->
                    <div class="col-lg-3 col-md-6 col-12">
                        <h5 class="footer-heading text-white fw-bold mb-3" style="font-size: 1.15rem;">Follow us</h5>
                        <div class="honna-social-grid">
                            <a href="#" class="honna-social-circle" aria-label="Instagram">
