<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Replace icon-only save / discard with labeled Save and Cancel buttons in Odoo 20 -->
    <t t-name="web.FormStatusIndicator" t-inherit="web.FormStatusIndicator" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_form_button_save')]" position="replace">
            <button
                type="button"
                class="o_form_button_save btn btn-primary btn-sm me-1"
                data-hotkey="s"
                t-on-click.stop="this.save"
                aria-label="Save"
                data-available-offline=""
                t-att-disabled="!this.props.isNew and this.indicatorMode === 'invalid'">
                Save
            </button>
        </xpath>
        <xpath expr="//button[hasclass('o_form_button_cancel')]" position="replace">
            <button
                type="button"
                class="o_form_button_cancel btn btn-secondary btn-sm"
                data-hotkey="j"
                t-on-click.stop="this.discard"
                data-available-offline=""
                aria-label="Cancel">
                Cancel
            </button>
        </xpath>
    </t>

</templates>
